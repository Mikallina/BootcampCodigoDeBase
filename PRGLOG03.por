programa
{
	
	funcao inicio()
	{
		cadeia nome
		inteiro idade
		real salario

		escreva("Qual seu nome: ")
		leia(nome)
		escreva("Qual sua idade: ")
		leia(idade)
		escreva("Qual o seu salário: ")
		leia(salario)
		limpa()

		escreva("FUNCIONÁRIO: ", nome, " TEM ", idade, " ANOS E RECEBE R$ ", salario, " POR MÊS")
	}
}
