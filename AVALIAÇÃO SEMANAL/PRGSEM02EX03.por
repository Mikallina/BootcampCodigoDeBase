programa

{
	funcao inicio()
	{
/*---------- DECLARACOES ----------------------------*/	     	
	     inteiro n1
	     inteiro n2
/*---------- ENTRADAS ----------------------------*/	     
		escreva("Qual valor do numero 1  ?")
		   leia(n1)
          escreva("Qual valor do numero 2  ?")
		   leia(n2)
/*--------- DECISÃO / SAIDA ----------------------------*/
           limpa()
              se (n1 > n2)
                escreva ("Primeiro numero é maior")
             senao
                escreva ("Segundo numero é maior")
	}
}

