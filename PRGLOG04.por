programa
{
	
	funcao inicio()
	{
		real num1, num2, resultado
		escreva("Digite um valor para Nº 1: ")
		leia(num1)
		escreva("Digite um valor para Nº 2: ")
		leia(num2)
		limpa()

		/* ------Soma------*/
		resultado = num1 + num2
		escreva("Soma: ", resultado, "\n")
		/* ------Subtração------*/
		resultado = num1 - num2
		escreva("Subtração: ", resultado, "\n")
		/* ------Divisão------*/
		resultado = num1 / num2
		escreva("Divisão: ", resultado,"\n")
		/* ------Multiplicação------*/
		resultado = num1 * num2
		escreva("Multiplicação: ", resultado,"\n")
		/* ------Média------*/
		resultado = (num1 + num2) / 2
		escreva("Média: ", resultado)

		
		
	}
}
