programa
{
	
	funcao inicio()
	{
		cadeia nome
		inteiro ano
		caracter tipoSanguineo
		real rendaMensal

		escreva("Qual seu nome..: ")
		leia(nome)
		escreva("Qual seu ano de nascimento..: ")
		leia(ano)
		escreva("Qual seu tipo sanguineo (A ou O)..: ")
		leia(tipoSanguineo)
		escreva("Qual sua renda mensal..:")
		leia(rendaMensal)
		limpa()

		escreva("Olá, meu nome é ", nome, ". Nasci em ", ano, ". - Meu tipo sanguineo é ..: ", tipoSanguineo, ". - Recebo por mês R$ ", rendaMensal)
	}
}
