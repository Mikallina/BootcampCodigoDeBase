programa
{
	
	funcao inicio()
	{
		inteiro estado
		escreva("Digite seu Estado: \n")
		escreva("1 - SP \n2 - MG \n3 - RJ \n")
		leia(estado)
		escolha(estado) {
			caso 1: escreva("Paulista") pare
			caso 2: escreva("Mineiro") pare
			caso 3: escreva("Carioca") pare 
			caso contrario: {escreva("Digite uma opção Válida")}
			
			}
		
		
	}
}
