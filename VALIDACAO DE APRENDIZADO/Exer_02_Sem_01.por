programa
{
	funcao inicio()
	{
          cadeia  nome
          inteiro salario
          inteiro novo_salario
          
		escreva("Qual seu nome ? ")
		  leia(nome)
                escreva("Qual seu Salario ? ")
		  leia(salario)

		novo_salario = salario * 2

		escreva ("Seu novo salario = " , novo_salario)
	}
}
